#!/usr/bin/env python3
"""Contract-test-only dependency injection for the Pi wrapper.

This file is not installed or referenced by production entrypoints.
"""
import os
import runpy
import sys
from pathlib import Path

# The test-only agent-draft harness supplies this wrapper directly and names its source root in
# HERMES_TEST_REPO_ROOT. Standalone fixture tests retain the normal relative fallback.
ROOT = Path(os.environ["HERMES_TEST_REPO_ROOT"]).resolve() if os.environ.get(
    "HERMES_TEST_REPO_ROOT"
) else Path(__file__).resolve().parents[3]
ns = runpy.run_path(str(ROOT / "scripts" / "pi" / "run-pi-busdriver-draft"))
globals_ = ns["main"].__globals__
globals_["production_dispatch_blocker"] = lambda _args: None
def test_trusted_pi_executable(value: str) -> Path:
    injected = os.environ.get("HERMES_TEST_PI_BIN")
    if injected:
        return Path(injected).resolve()
    return Path(value).expanduser().resolve()

globals_["trusted_pi_executable"] = test_trusted_pi_executable
globals_["trusted_node_executable"] = lambda: Path(sys.executable).resolve()
globals_["trusted_cursor_extension"] = lambda: None
globals_["base_child_environment"] = lambda: {
    key: value for key, value in globals_["os"].environ.items()
    if key in {"TMPDIR", "TMP", "TEMP", "LANG", "LC_ALL", "LC_CTYPE", "USER", "LOGNAME", "TERM", "NO_COLOR", "FAKE_PI_TARGET", "FAKE_PI_CONTENT", "HERMES_TEST_AGENT_CMD", "HERMES_TEST_PI_BIN", "HERMES_AGENT_DRAFT_GUARD_BIN", "BUSDRIVER_PLUGIN_ROOT", "BUSDRIVER_STATE_DIR"}
}
if not any(arg == "--provider" or arg.startswith("--provider=") for arg in sys.argv[1:]):
    sys.argv += ["--provider", os.environ.get("PI_BD_PROVIDER", "cursor")]
if not any(arg == "--model" or arg.startswith("--model=") for arg in sys.argv[1:]):
    sys.argv += ["--model", os.environ.get("PI_BD_MODEL", "cursor/auto")]
raise SystemExit(ns["main"]())
